    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:smoke": "tsx --env-file=.env scripts/db-smoke.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
