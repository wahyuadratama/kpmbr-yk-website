# =============================================================================
# KPMBR-YK — Environment Variables (CONTOH)
# Copy ke .env lalu isi dengan nilai asli. JANGAN commit .env.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Laragon MySQL 8 — user: root, password: (kosong) adalah default Laragon.
# Host DB di laptop bisa `localhost` atau `127.0.0.1` (MySQL Laragon kadang
# hanya bind ke 127.0.0.1). Gunakan 127.0.0.1 bila `localhost` gagal.
DATABASE_URL="mysql://root:@localhost:3306/kpmbr_db"

# --- Next.js ----------------------------------------------------------------
# URL publik situs. Production: https://kpmbr.id
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js ----------------------------------------------------------------
# WAJIB random & rahasia. Generate dengan: npx auth secret
AUTH_SECRET=""
# Diperlukan agar Auth.js memakai header host dari reverse proxy (Laragon/Apache)
AUTH_TRUST_HOST="true"

# --- Cloudflare R2 (S3-compatible object storage) ---------------------------
# Semua file binary (foto, PDF, LPJ, proposal) disimpan di sini.
# Database hanya menyimpan metadata file.
# Bucket R2 TIDAK boleh public-read untuk dokumen access-level-restricted;
# publik served lewat signed URL / proxy route yang memeriksa otorisasi.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kpmbr-files"
# URL dasar untuk aset yang memang boleh publik, mis.
# https://pub-<account>.r2.dev  (tanpa trailing slash)
R2_PUBLIC_URL=""
